# Discord Server Details
DISCORD_GUILD_ID=your_guild_id
DISCORD_RECS_CHANNEL_ID=your_recs_channel_id

# Discord Webhook (Channel: ✻・recs)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Discord Application Credentials (from https://discord.com/developers/applications)
DISCORD_APPLICATION_ID=your_app_id
DISCORD_PUBLIC_KEY=your_public_key
DISCORD_BOT_TOKEN=your_bot_token

# Web Portal Base URL & Custom Branding (Optional)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_RECIPIENT_NAME="Jizelle"
NEXT_PUBLIC_REPO_URL="https://github.com/jijishub/discord-rec-bot"
NEXT_PUBLIC_RECIPIENT_PRONOUN="her"

# Persistent Bot Persona across all devices (Zero DB required!)
BOT_USERNAME="Jasmine 🌸"
BOT_AVATAR_URL="/maomao.png"
BOT_FOOTER="Rec by {source}"

# AI Auto-fill Configuration (Optional)
AI_API_BASE_URL=https://your-ai-endpoint.example/v1
AI_API_KEY=your_key_here
AI_DEFAULT_MODEL=gpt-5.6-luna
# Optional comma-separated quick picks; otherwise discovered from the provider's /models endpoint
AI_MODELS=

# Upstash Redis / Vercel KV (Optional - Auto-populated if linked via Vercel Storage)
# Permanently syncs your custom 1:1 flower icons and categories across all devices & browsers
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# Admin Portal Protection (Google SSO)
# Protects custom categories, flower icons, and persona from being reset or overwritten by public visitors
ADMIN_EMAIL=your_email@gmail.com
# Optional dedicated signing secret; otherwise GOOGLE_CLIENT_SECRET is used
ADMIN_SESSION_SECRET=
# Optional: comma-separated list of additional admin emails if needed:
# ADMIN_EMAILS=your_email@gmail.com,alt@gmail.com
# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
